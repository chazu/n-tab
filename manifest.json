{
  "manifest_version": 3,
  "name": "NTab",
  "version": "0.0.2",
  "description": "Keep at most N tabs open per window. The oldest excess tabs are shunted to NTab, a OneTab-style list of unique pages.",
  "permissions": ["tabs", "storage"],
  "background": {
    "service_worker": "background.js",
    "scripts": ["reuse.js", "background.js"]
  },
  "action": {
    "default_title": "Open NTab"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "ntab@chazu.dev",
      "strict_min_version": "115.0"
    }
  }
}
